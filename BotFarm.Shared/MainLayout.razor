@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Sections
@using BotFarm.Shared.Components

<MudThemeProvider Theme="Theme" @bind-IsDarkMode="@_isDarkMode" @ref="_mudThemeProvider" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@LayoutClass">
    <MudAppBar Dense Elevation="0" Class="app-bar">
        <MudToggleIconButton Edge="Edge.Start" Color="Color.Inherit" Icon="@Icons.Material.Filled.Menu" ToggledIcon="@Icons.Material.Filled.MenuOpen" @bind-Toggled="_drawerOpen"
                             aria-label="@L["AppBar.ToggleNav"]" />
        <MudAvatar Size="Size.Small" Class="ml-2 app-logo">
            <SectionOutlet SectionName="LogoSection" />
        </MudAvatar>
        <MudText Typo="Typo.h6" Class="ml-3 app-title">
            <SectionOutlet SectionName="TitleSection" />
        </MudText>
        <MudSpacer/>
        <LanguagePicker />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="ToggleDarkMode"
                       aria-label="@(_isDarkMode ? L["AppBar.LightMode"] : L["AppBar.DarkMode"])" />
        <form method="post" action="Account/Logout" style="display: contents">
            <AntiforgeryToken />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" ButtonType="ButtonType.Submit"
                           aria-label="@L["AppBar.SignOut"]" title="@L["AppBar.SignOut"]" />
        </form>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Elevation="0" Class="app-drawer">
        <MudNavMenu Class="app-nav pa-3">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">@L["Nav.Home"]</MudNavLink>
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Outlined.Dashboard">@L["Nav.Dashboard"]</MudNavLink>
            <MudNavLink Href="/health-ui" Icon="@Icons.Material.Outlined.MonitorHeart">@L["Nav.Health"]</MudNavLink>
            @if (BotModules.Any())
            {
                <MudText Typo="Typo.overline" Class="app-nav-label mt-4">@L["Nav.Bots"]</MudText>
                @foreach (var bot in BotModules)
                {
                    var emoji = Options.Get(bot.Name).Emoji;
                    @if (string.IsNullOrWhiteSpace(emoji))
                    {
                        <MudNavLink Href=@($"/{bot.Name}/dashboard") Icon="@Icons.Material.Outlined.SmartToy">@bot.Name</MudNavLink>
                    }
                    else
                    {
                        <MudNavLink Href=@($"/{bot.Name}/dashboard") Class="app-nav-bot">
                            <span class="app-nav-emoji" aria-hidden="true">@emoji</span>@bot.Name
                        </MudNavLink>
                    }
                }
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="app-main">
        <div class="app-content">
            <MudGrid Spacing="4">
                @Body
            </MudGrid>
        </div>
        <footer class="app-footer">
            <MudText Typo="Typo.caption">
                <SectionOutlet SectionName="FooterSection" />
            </MudText>
        </footer>
    </MudMainContent>
</MudLayout>
