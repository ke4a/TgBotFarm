@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits DashboardComponentBase
<MudPaper Elevation="0" Class="card">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudTooltip Delay="500" Text="Refresh">
            <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.Refresh" Disabled="@_loadingChatIds" OnClick="RefreshChats" aria-label="Refresh" />
        </MudTooltip>
    </MudStack>

    <MudTable @ref="_table" T="ChatRow" ServerData="LoadPage" Dense Hover="true" RowsPerPage="10">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>ID</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#" Class="cell-muted">@context.Number</MudTd>
            <MudTd DataLabel="Name" Class="copy-cell">
                @context.Name
                @if (context.Available)
                {
                    <MudIconButton Class="copy-button" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" title="Copy name" aria-label="Copy name" OnClick='() => CopyToClipboard(context.Name, "Name")' />
                }
            </MudTd>
            <MudTd DataLabel="ID" Class="copy-cell cell-mono">
                @context.Id
                <MudIconButton Class="copy-button" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" title="Copy ID" aria-label="Copy ID" OnClick='() => CopyToClipboard(context.Id.ToString(), "ID")' />
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudTooltip Delay="500" Text="Send message">
                    <MudIconButton Class="action-btn" Color="Color.Primary" Icon="@Icons.Material.Outlined.Send" Disabled="@(!context.Available)" OnClick="() => SendMessage(context)" aria-label="Send message" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No chats found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@_pageSizeOptions" />
        </PagerContent>
    </MudTable>
</MudPaper>
