@using BotFarm.Shared.Utilities
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits DashboardComponentBase
<MudPaper Elevation="0" Class="card">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudStack Row Spacing="0">
            <MudTooltip Delay="500" Text="Send message to all chats">
                <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Filled.Campaign" Disabled="@(_loadingChatIds || _working)" OnClick="BroadcastMessage" aria-label="Send message to all chats" />
            </MudTooltip>
            <MudTooltip Delay="500" Text="Clean up unreachable chats">
                <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.DeleteSweep" Disabled="@(_loadingChatIds || _working)" OnClick="CleanUpUnreachableChats" aria-label="Clean up unreachable chats" />
            </MudTooltip>
            <MudTooltip Delay="500" Text="Refresh">
                <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.Refresh" Disabled="@(_loadingChatIds || _working)" OnClick="RefreshChats" aria-label="Refresh" />
            </MudTooltip>
        </MudStack>
    </MudStack>

    @if (_progressTotal > 0)
    {
        <MudText Typo="Typo.caption" Class="cell-muted">@_progressLabel: @_progressDone / @_progressTotal</MudText>
        <MudProgressLinear Color="Color.Primary" Value="@_progressDone" Max="@_progressTotal" />
    }

    <MudTable @ref="_table" T="ChatRow" ServerData="LoadPage" Dense Hover="true" RowsPerPage="10">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>ID</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#" Class="cell-muted">@context.Number</MudTd>
            <MudTd DataLabel="Name" Class="copy-cell">
                @{ var shortName = FormatUtils.Truncate(context.Name, MaxNameLength); }
                @if (shortName.Length < context.Name.Length)
                {
                    <MudTooltip Delay="300" Text="@context.Name">
                        <span class="chat-name">@shortName</span>
                    </MudTooltip>
                }
                else
                {
                    <span class="chat-name">@context.Name</span>
                }
                @if (context.Available)
                {
                    <MudIconButton Class="copy-button" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" title="Copy name" aria-label="Copy name" OnClick='() => CopyToClipboard(context.Name, "Name", Logger)' />
                }
            </MudTd>
            <MudTd DataLabel="ID" Class="copy-cell cell-mono">
                @context.Id
                <MudIconButton Class="copy-button" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" title="Copy ID" aria-label="Copy ID" OnClick='() => CopyToClipboard(context.Id.ToString(), "ID", Logger)' />
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudTooltip Delay="500" Text="Send message">
                    <MudIconButton Class="action-btn" Color="Color.Primary" Icon="@Icons.Material.Outlined.Send" Disabled="@(!context.Available)" OnClick="() => SendMessage(context)" aria-label="Send message" />
                </MudTooltip>
                <MudTooltip Delay="500" Text="Delete chat data">
                    <MudIconButton Class="action-btn" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" Disabled="@_working" OnClick="() => DeleteChat(context)" aria-label="Delete chat data" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No chats found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@_pageSizeOptions" />
        </PagerContent>
    </MudTable>
</MudPaper>
