@using BotFarm.Shared.Utilities
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits DashboardComponentBase
<MudPaper Elevation="0" Class="card">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
        <MudText Typo="Typo.h6">@(Title ?? L["Chats.Title"])</MudText>
        <MudStack Row Spacing="0">
            <MudTooltip Delay="500" Text="@L["Chats.Broadcast.Action"]">
                <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Filled.Campaign" Disabled="@(_loadingChatIds || _working)" OnClick="BroadcastMessage" aria-label="@L["Chats.Broadcast.Action"]" />
            </MudTooltip>
            <MudTooltip Delay="500" Text="@L["Chats.CleanUp.Action"]">
                <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.DeleteSweep" Disabled="@(_loadingChatIds || _working)" OnClick="CleanUpUnreachableChats" aria-label="@L["Chats.CleanUp.Action"]" />
            </MudTooltip>
            <MudTooltip Delay="500" Text="@L["Common.Refresh"]">
                <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.Refresh" Disabled="@(_loadingChatIds || _working)" OnClick="RefreshChats" aria-label="@L["Common.Refresh"]" />
            </MudTooltip>
        </MudStack>
    </MudStack>

    @if (_progressTotal > 0)
    {
        <MudText Typo="Typo.caption" Class="cell-muted">@_progressLabel: @_progressDone / @_progressTotal</MudText>
        <MudProgressLinear Color="Color.Primary" Value="@_progressDone" Max="@_progressTotal" />
    }

    <MudTable @ref="_table" T="ChatRow" ServerData="LoadPage" Dense Hover="true" RowsPerPage="10">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>@L["Common.Name"]</MudTh>
            <MudTh>@L["Common.Id"]</MudTh>
            <MudTh>@L["Common.Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#" Class="cell-muted">@context.Number</MudTd>
            <MudTd DataLabel="@L["Common.Name"]" Class="copy-cell">
                @{ var shortName = FormatUtils.Truncate(context.Name, MaxNameLength); }
                @if (shortName.Length < context.Name.Length)
                {
                    <MudTooltip Delay="300" Text="@context.Name">
                        <span class="chat-name">@shortName</span>
                    </MudTooltip>
                }
                else
                {
                    <span class="chat-name">@context.Name</span>
                }
                @if (context.Available)
                {
                    <MudIconButton Class="copy-button" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" title="@L["Chats.CopyName"]" aria-label="@L["Chats.CopyName"]" OnClick='() => CopyToClipboard(context.Name, L["Common.Name"], Logger)' />
                }
            </MudTd>
            <MudTd DataLabel="@L["Common.Id"]" Class="copy-cell cell-mono">
                @context.Id
                <MudIconButton Class="copy-button" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" title="@L["Chats.CopyId"]" aria-label="@L["Chats.CopyId"]" OnClick='() => CopyToClipboard(context.Id.ToString(), L["Common.Id"], Logger)' />
            </MudTd>
            <MudTd DataLabel="@L["Common.Actions"]">
                <MudTooltip Delay="500" Text="@L["Chats.SendMessage"]">
                    <MudIconButton Class="action-btn" Color="Color.Primary" Icon="@Icons.Material.Outlined.Send" Disabled="@(!context.Available)" OnClick="() => SendMessage(context)" aria-label="@L["Chats.SendMessage"]" />
                </MudTooltip>
                <MudTooltip Delay="500" Text="@L["Chats.Delete.Action"]">
                    <MudIconButton Class="action-btn" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" Disabled="@_working" OnClick="() => DeleteChat(context)" aria-label="@L["Chats.Delete.Action"]" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["Chats.Empty"]</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@_pageSizeOptions" RowsPerPageString="@L["Chats.Pager.RowsPerPage"]" InfoFormat="@L["Chats.Pager.Info"]" />
        </PagerContent>
    </MudTable>
</MudPaper>
