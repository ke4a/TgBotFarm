@using BotFarm.Shared.Utilities
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inherits DashboardComponentBase
<MudPaper Elevation="0" Class="card">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
        <MudText Typo="Typo.h6">@L["Stats.Title"]</MudText>
        <MudTooltip Delay="500" Text="@L["Common.Refresh"]">
            <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.Refresh" Disabled="@_loadingStats" OnClick="LoadStats" aria-label="@L["Common.Refresh"]" />
        </MudTooltip>
    </MudStack>

    <MudText Typo="Typo.overline" Class="stat-group-title">
        <MudIcon Icon="@Icons.Material.Outlined.SmartToy" Size="Size.Small" /> @L["Stats.Bot"]
    </MudText>
    <div class="stat-row">
        <MudText Typo="Typo.body2" Class="stat-label">@L["Stats.ChatsCount"]</MudText>
        <MudText Typo="Typo.body2" Class="stat-value">@(_chatsCount?.ToString() ?? L["Units.NotAvailable"])</MudText>
    </div>
    @foreach (var stat in _additionalStats)
    {
        <div class="stat-row">
            <MudText Typo="Typo.body2" Class="stat-label">@stat.Key</MudText>
            <MudText Typo="Typo.body2" Class="stat-value">@(stat.Value ?? L["Units.NotAvailable"])</MudText>
        </div>
    }

    <MudText Typo="Typo.overline" Class="stat-group-title mt-4">
        <MudIcon Icon="@Icons.Material.Outlined.Storage" Size="Size.Small" /> @L["Stats.Database"]
    </MudText>
    <div class="stat-row">
        <MudText Typo="Typo.body2" Class="stat-label">@L["Stats.IndexSize"]</MudText>
        <MudText Typo="Typo.body2" Class="stat-value">@(FormatUtils.FormatBytes(_dbStats?.IndexSize, 2, L))</MudText>
    </div>
    <div class="stat-row">
        <MudText Typo="Typo.body2" Class="stat-label">@L["Stats.StorageSize"]</MudText>
        <MudText Typo="Typo.body2" Class="stat-value">@(FormatUtils.FormatBytes(_dbStats?.StorageSize, 2, L))</MudText>
    </div>
    <div class="stat-row">
        <MudText Typo="Typo.body2" Class="stat-label">@L["Stats.TotalSize"]</MudText>
        <MudText Typo="Typo.body2" Class="stat-value">@(FormatUtils.FormatBytes(_dbStats?.TotalSize, 2, L))</MudText>
    </div>
</MudPaper>
