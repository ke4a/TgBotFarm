@using BotFarm.Core.Models
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<MudStack Spacing="1" Class="@Class">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        @Label
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            @if (IsApplying)
            {
                <MudText Typo="Typo.caption" Class="stat-label">Applying...</MudText>
            }
            <MudSwitch T="bool"
                       Ripple="false"
                       Value="@(Status.DesiredEnabled ?? false)"
                       ValueChanged="SetEnabled"
                       Disabled="@IsSwitchDisabled"
                       Color="Color.Success"
                       aria-label="@($"{Status.BotName} enabled")" />
        </MudStack>
    </MudStack>

    @if (ProblemMessage is { } problemMessage)
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">@problemMessage</MudText>
                @if (Status.Status is BotRuntimeState.Unknown or BotRuntimeState.Error)
                {
                    <MudButton Size="Size.Small" Disabled="@_working" OnClick="Retry">Retry</MudButton>
                }
            </MudStack>
        </MudAlert>
    }
</MudStack>
