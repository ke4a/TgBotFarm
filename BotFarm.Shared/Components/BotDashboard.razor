@using Microsoft.AspNetCore.Components.Sections
@inject IMetricsLinks Links

<SectionContent SectionName="TitleSection">@BotName</SectionContent>
@if (!string.IsNullOrWhiteSpace(LogoSrc))
{
    <SectionContent SectionName="LogoSection">
        <MudImage Fluid Src="@LogoSrc" Alt="@BotName" Class="rounded-lg" />
    </SectionContent>
}

@if (Links.ForBot(BotName) is { Length: > 0 } metricsUrl)
{
    <SectionContent SectionName="ActionsSection">
        <MetricsLink Href="@metricsUrl" />
    </SectionContent>
}
<MudItem xs="12" sm="8">
    <MudStack Spacing="4">
        <DashboardBackups BotName="@BotName" />
        <DashboardChats BotName="@BotName" />
        @MainExtra
    </MudStack>
</MudItem>
<MudItem xs="12" sm="4">
    <MudStack Spacing="4">
        @* Sibling keys must be unique, so each card pairs the shared version with its own name. *@
        <DashboardBotSettings @key="(nameof(DashboardBotSettings), _settingsVersion)" BotName="@BotName" OnSaved="HandleSettingsSaved" />
        <DashboardWebhook @key="(nameof(DashboardWebhook), _settingsVersion)" BotName="@BotName" OnSettingsSaved="HandleSettingsSaved" />
        @if (Stats is null)
        {
            <DashboardStats BotName="@BotName" />
        }
        else
        {
            @Stats
        }
        @SideExtra
    </MudStack>
</MudItem>
@ChildContent

@if (Footer is not null)
{
    <SectionContent SectionName="FooterSection">@Footer</SectionContent>
}

@code {
    private int _settingsVersion;

    /// <summary>
    /// The bot the cards operate on, also shown as the app bar title, used as the logo's alt text and selected in the
    /// monitoring dashboard the Metrics link above the cards opens.
    /// </summary>
    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    /// <summary>
    /// The URL of the logo shown in the app bar. No logo is shown when it is empty.
    /// </summary>
    [Parameter]
    public string? LogoSrc { get; set; }

    /// <summary>
    /// The content of the page footer.
    /// </summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>
    /// A replacement for the standard stats card, e.g. a <see cref="DashboardStats"/> subclass with bot-specific stats.
    /// </summary>
    [Parameter]
    public RenderFragment? Stats { get; set; }

    /// <summary>
    /// Extra cards placed below the standard cards in the wide column.
    /// </summary>
    [Parameter]
    public RenderFragment? MainExtra { get; set; }

    /// <summary>
    /// Extra cards placed below the standard cards in the narrow column.
    /// </summary>
    [Parameter]
    public RenderFragment? SideExtra { get; set; }

    /// <summary>
    /// Extra grid items placed after both columns, e.g. a full-width <c>MudItem xs="12"</c>.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Recreates the Settings and Webhook cards after a settings save from either of them, so both show the bot's
    /// settings, status and webhook as they are now.
    /// </summary>
    private void HandleSettingsSaved() => _settingsVersion++;
}
