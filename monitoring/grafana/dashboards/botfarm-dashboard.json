{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "name": "Backup created",
        "expr": "sum(botfarm_bot_events_total{bot=\"$bot\", event=\"backup_created\"} - botfarm_bot_events_total{bot=\"$bot\", event=\"backup_created\"} offset $__interval) > 0",
        "step": "2m",
        "titleFormat": "Backup created",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "name": "Backup restored",
        "expr": "sum(botfarm_bot_events_total{bot=\"$bot\", event=\"backup_restored\"} - botfarm_bot_events_total{bot=\"$bot\", event=\"backup_restored\"} offset $__interval) > 0",
        "step": "2m",
        "titleFormat": "Backup restored",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Backup failed",
        "expr": "sum(botfarm_bot_events_total{bot=\"$bot\", event=\"backup_failed\"} - botfarm_bot_events_total{bot=\"$bot\", event=\"backup_failed\"} offset $__interval) > 0",
        "step": "2m",
        "titleFormat": "Backup failed",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Restore failed",
        "expr": "sum(botfarm_bot_events_total{bot=\"$bot\", event=\"restore_failed\"} - botfarm_bot_events_total{bot=\"$bot\", event=\"restore_failed\"} offset $__interval) > 0",
        "step": "2m",
        "titleFormat": "Restore failed",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "name": "Bot turned on",
        "expr": "sum(botfarm_bot_events_total{bot=\"$bot\", event=\"bot_enabled\"} - botfarm_bot_events_total{bot=\"$bot\", event=\"bot_enabled\"} offset $__interval) > 0",
        "step": "2m",
        "titleFormat": "Bot turned on",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Bot turned off",
        "expr": "sum(botfarm_bot_events_total{bot=\"$bot\", event=\"bot_disabled\"} - botfarm_bot_events_total{bot=\"$bot\", event=\"bot_disabled\"} offset $__interval) > 0",
        "step": "2m",
        "titleFormat": "Bot turned off",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "yellow",
        "name": "Pending updates dropped",
        "expr": "sum(botfarm_bot_events_total{bot=\"$bot\", event=\"pending_updates_dropped\"} - botfarm_bot_events_total{bot=\"$bot\", event=\"pending_updates_dropped\"} offset $__interval) > 0",
        "step": "2m",
        "titleFormat": "Pending updates dropped",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "light-purple",
        "name": "Settings changed",
        "expr": "sum(botfarm_bot_events_total{bot=\"$bot\", event=\"settings_changed\"} - botfarm_bot_events_total{bot=\"$bot\", event=\"settings_changed\"} offset $__interval) > 0",
        "step": "2m",
        "titleFormat": "Settings changed",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "App restarted",
        "expr": "count by (instance) (botfarm_memory_working_set_bytes) unless count by (instance) (botfarm_memory_working_set_bytes offset $__interval)",
        "step": "2m",
        "titleFormat": "App restarted",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false
      }
    ]
  },
  "description": "Update throughput, errors, handling time and command usage of each BotFarm bot, and the app's memory.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Updates the bot handled, by kind. Each bar is an estimate from the exported counters over its interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "interval": "2m",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Updates",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.8,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "command"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Commands"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "callback_query"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Callback queries"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Other"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (kind) (botfarm_updates_total{bot=\"$bot\"} - botfarm_updates_total{bot=\"$bot\"} offset $__interval)",
          "legendFormat": "{{kind}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors",
      "description": "Deliveries that failed, were retried or dropped, duplicates skipped and rejected webhook requests. Duplicates skipped are not failures. Each point is an estimate from the exported counters over its interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "interval": "2m",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Deliveries",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.8,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Failed"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "retried"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Retried"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dropped"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Dropped"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duplicate"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Duplicates skipped"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Webhook rejected"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (botfarm_update_outcomes_total{bot=\"$bot\"} - botfarm_update_outcomes_total{bot=\"$bot\"} offset $__interval)",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Handling time",
      "description": "Median (p50) and 95th percentile (p95) of the time the bot took to handle an update, against the webhook deadline Telegram waits for a response.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Handling time",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.8,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(botfarm_update_duration_seconds_bucket{bot=\"$bot\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(botfarm_update_duration_seconds_bucket{bot=\"$bot\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "vector(60)",
          "legendFormat": "Webhook deadline",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Command usage",
      "description": "Commands the bot handled over the selected time range, most used first. Commands the bot does not know are grouped as Unknown command. Counts are estimates from the exported counters over the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/(unknown)"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Unknown command"
              }
            ]
          }
        ]
      },
      "options": {
        "displayMode": "basic",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sort_desc(sum by (command) (increase(botfarm_commands_total{bot=\"$bot\"}[$__range])))",
          "instant": true,
          "legendFormat": "/{{command}}",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "App memory",
      "description": "The app's working set and GC heap size, against the memory warning threshold of the health check. The GC heap is measured at the last garbage collection, so a steady climb over days points to a leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Memory",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.8,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0,
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(botfarm_memory_working_set_bytes)",
          "legendFormat": "Working set",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(botfarm_memory_gc_heap_bytes)",
          "legendFormat": "GC heap",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(botfarm_memory_threshold_bytes)",
          "legendFormat": "Threshold",
          "range": true,
          "refId": "C"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 40,
  "tags": [
    "botfarm"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(botfarm_updates_total, bot)",
        "hide": 0,
        "includeAll": false,
        "label": "Bot",
        "multi": false,
        "name": "bot",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(botfarm_updates_total, bot)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "quick_ranges": [
      {
        "display": "Last 1 hour",
        "from": "now-1h",
        "to": "now"
      },
      {
        "display": "Last 24 hours",
        "from": "now-24h",
        "to": "now"
      },
      {
        "display": "Last 7 days",
        "from": "now-7d",
        "to": "now"
      }
    ],
    "time_options": [
      "1h",
      "24h",
      "7d"
    ]
  },
  "timezone": "browser",
  "title": "BotFarm",
  "uid": "botfarm",
  "version": 1
}
