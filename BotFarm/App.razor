@using System.Globalization
@using BotFarm.Components
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="img/fav.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="lib/quill/quill.snow.min.css" />
    <link rel="stylesheet" href="css/site.css" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <Routes DarkModePreference="@DarkModePreference" @rendermode="RenderMode.InteractiveServer" />
    <ReconnectModal />
    <script src="lib/quill/quill.min.js"></script>
    <script src="js/site.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>

@code {
    private const string DarkModeCookieName = "darkModePreference";

    private bool? DarkModePreference
    {
        get
        {
            var storedValue = HttpContextAccessor.HttpContext?.Request.Cookies[DarkModeCookieName];
            return bool.TryParse(storedValue, out var darkModePreference)
                ? darkModePreference
                : null;
        }
    }
}