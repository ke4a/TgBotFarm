@using BotFarm.Core.Services
@using Microsoft.AspNetCore.Components.Sections
@inject IEnumerable<IBotModule> BotModules

<CascadingValue Value="DarkModePreference">
    <PageTitle>BotFarm</PageTitle>
    <SectionContent SectionName="TitleSection">BotFarm</SectionContent>
    <SectionContent SectionName="LogoSection">
        <MudImage Fluid Src="img/logo.png" Alt="logo" Class="rounded-lg" />
    </SectionContent>

    <Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="_botAssemblies">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Nothing to see here...</p>
            </LayoutView>
        </NotFound>
    </Router>

    <SectionContent SectionName="FooterSection">Do Telegram bots dream of premium users?</SectionContent>
</CascadingValue>

@code {
    private System.Reflection.Assembly[] _botAssemblies = [];

    [Parameter]
    public bool? DarkModePreference { get; set; }

    protected override void OnInitialized()
    {
        _botAssemblies = BotModuleDiscovery.GetComponentsAssemblies(BotModules);
    }
}
