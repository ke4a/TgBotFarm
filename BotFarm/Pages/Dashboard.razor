@page "/dashboard"
@attribute [Authorize]
@using BotFarm.Core.Models

<PageTitle>Dashboard - BotFarm</PageTitle>
<h1 class="mud-sr-only">Dashboard</h1>

<MudItem xs="12" sm="12" md="8">
    <MudPaper Elevation="0" Class="card">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
            <MudText Typo="Typo.h6">Logs</MudText>
            <MudTooltip Delay="500" Text="Refresh">
                <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.Refresh" Disabled="@_loadingLogs" OnClick="LoadLogs" aria-label="Refresh logs" />
            </MudTooltip>
        </MudStack>

        <MudTable T="LogFileEntry" Items="@_logFiles" Dense Hover="true" Loading="@_loadingLogs">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Size</MudTh>
                <MudTh>Updated</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#" Class="cell-muted">@context.Number</MudTd>
                <MudTd DataLabel="Name" Class="cell-mono">@context.Name</MudTd>
                <MudTd DataLabel="Size" Class="cell-muted">@FormatUtils.FormatBytes(context.Size, 1)</MudTd>
                <MudTd DataLabel="Updated" Class="cell-muted">@context.LastModified.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row Spacing="1">
                        <MudTooltip Delay="500" Text="View">
                            <MudIconButton Class="action-btn" Color="Color.Primary" Icon="@Icons.Material.Outlined.Visibility" OnClick="() => ViewLog(context)" aria-label="View" />
                        </MudTooltip>
                        <MudTooltip Delay="500" Text="Download">
                            <MudIconButton Class="action-btn" Color="Color.Success" Icon="@Icons.Material.Outlined.FileDownload" OnClick="() => DownloadLog(context)" aria-label="Download" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No log files found.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudItem>

<MudItem xs="12" sm="12" md="4">
    <MudStack Spacing="4">
        <MudPaper Elevation="0" Class="card">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
                <MudText Typo="Typo.h6">Application</MudText>
                <MudStack Row Spacing="1">
                    <MudTooltip Delay="500" Text="Refresh">
                        <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.Refresh" Disabled="@_loadingStats" OnClick="LoadHealth" aria-label="Refresh application stats" />
                    </MudTooltip>
                    <MudTooltip Delay="500" Text="Shutdown">
                        <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.StopCircle" Disabled="@_shuttingDown" OnClick="ConfirmShutdown" aria-label="Shutdown" />
                    </MudTooltip>
                </MudStack>
            </MudStack>

            <div class="stat-row">
                <MudText Typo="Typo.body2" Class="stat-label">Memory usage</MudText>
                <MudText Typo="Typo.body2" Class="stat-value">@(_memory ?? "Loading...")</MudText>
            </div>
            <div class="stat-row">
                <MudText Typo="Typo.body2" Class="stat-label">Uptime</MudText>
                <MudText Typo="Typo.body2" Class="stat-value">@(_uptime ?? "Loading...")</MudText>
            </div>
        </MudPaper>

        <MudPaper Elevation="0" Class="card">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
                <MudText Typo="Typo.h6">Bot controls</MudText>
                <MudTooltip Delay="500" Text="Refresh">
                    <MudIconButton Color="Color.Info"
                                   Icon="@Icons.Material.Filled.Refresh"
                                   Disabled="@_loadingBotStatuses"
                                   OnClick="LoadBotStatuses"
                                   aria-label="Refresh bot controls" />
                </MudTooltip>
            </MudStack>

            <MudStack Spacing="1">
                @foreach (var status in _botStatuses)
                {
                    <MudStack @key="status.BotName" Spacing="1" Class="py-2">
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body1" Class="stat-value">@status.BotName</MudText>
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                @if (IsBotApplying(status))
                                {
                                    <MudText Typo="Typo.caption" Class="stat-label">Applying...</MudText>
                                }
                                <MudSwitch T="bool"
                                           Ripple="false"
                                           Value="@(status.DesiredEnabled ?? false)"
                                           ValueChanged="@(enabled => SetBotEnabled(status.BotName, enabled))"
                                           Disabled="@IsBotSwitchDisabled(status)"
                                           Color="Color.Success"
                                           aria-label="@($"{status.BotName} enabled")" />
                            </MudStack>
                        </MudStack>

                        @if (GetBotProblemMessage(status) is { } problemMessage)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">@problemMessage</MudText>
                                    @if (status.Status is BotRuntimeState.Unknown or BotRuntimeState.Error)
                                    {
                                        <MudButton Size="Size.Small"
                                                   Disabled="@_workingBots.Contains(status.BotName)"
                                                   OnClick="@(() => RetryBotState(status.BotName))">
                                            Retry
                                        </MudButton>
                                    }
                                </MudStack>
                            </MudAlert>
                        }
                    </MudStack>
                }

                @if (_botStatuses.Count == 0 && !_loadingBotStatuses)
                {
                    <MudText>No registered bots.</MudText>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
</MudItem>