@page "/dashboard"
@attribute [Authorize]
@using BotFarm.Core.Models

<PageTitle>@L["Dashboard.PageTitle"]</PageTitle>
<h1 class="mud-sr-only">@L["Dashboard.Heading"]</h1>

<MudItem xs="12" sm="12" md="8">
    <MudPaper Elevation="0" Class="card">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
            <MudText Typo="Typo.h6">@L["Dashboard.Logs.Title"]</MudText>
            <MudTooltip Delay="500" Text="@L["Common.Refresh"]">
                <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.Refresh" Disabled="@_loadingLogs" OnClick="LoadLogs" aria-label="@L["Dashboard.Logs.Refresh"]" />
            </MudTooltip>
        </MudStack>

        <MudTable T="LogFileEntry" Items="@_logFiles" Dense Hover="true" Loading="@_loadingLogs">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>@L["Dashboard.Logs.Name"]</MudTh>
                <MudTh>@L["Dashboard.Logs.Size"]</MudTh>
                <MudTh>@L["Dashboard.Logs.Updated"]</MudTh>
                <MudTh>@L["Common.Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#" Class="cell-muted">@context.Number</MudTd>
                <MudTd DataLabel="@L["Dashboard.Logs.Name"]" Class="cell-mono">@context.Name</MudTd>
                <MudTd DataLabel="@L["Dashboard.Logs.Size"]" Class="cell-muted">@FormatUtils.FormatBytes(context.Size, 1, Units)</MudTd>
                <MudTd DataLabel="@L["Dashboard.Logs.Updated"]" Class="cell-muted">@context.LastModified.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</MudTd>
                <MudTd DataLabel="@L["Common.Actions"]">
                    <MudStack Row Spacing="1">
                        <MudTooltip Delay="500" Text="@L["Dashboard.Logs.View"]">
                            <MudIconButton Class="action-btn" Color="Color.Primary" Icon="@Icons.Material.Outlined.Visibility" OnClick="() => ViewLog(context)" aria-label="@L["Dashboard.Logs.View"]" />
                        </MudTooltip>
                        <MudTooltip Delay="500" Text="@L["Dashboard.Logs.Download"]">
                            <MudIconButton Class="action-btn" Color="Color.Success" Icon="@Icons.Material.Outlined.FileDownload" OnClick="() => DownloadLog(context)" aria-label="@L["Dashboard.Logs.Download"]" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@L["Dashboard.Logs.Empty"]</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudItem>

<MudItem xs="12" sm="12" md="4">
    <MudStack Spacing="4">
        <MudPaper Elevation="0" Class="card">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
                <MudText Typo="Typo.h6">@L["Dashboard.App.Title"]</MudText>
                <MudStack Row Spacing="1">
                    <MudTooltip Delay="500" Text="@L["Common.Refresh"]">
                        <MudIconButton Color="Color.Info" Icon="@Icons.Material.Filled.Refresh" Disabled="@_loadingStats" OnClick="LoadHealth" aria-label="@L["Dashboard.App.Refresh"]" />
                    </MudTooltip>
                    <MudTooltip Delay="500" Text="@L["Dashboard.Shutdown.Action"]">
                        <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.StopCircle" Disabled="@_shuttingDown" OnClick="ConfirmShutdown" aria-label="@L["Dashboard.Shutdown.Action"]" />
                    </MudTooltip>
                </MudStack>
            </MudStack>

            <div class="stat-row">
                <MudText Typo="Typo.body2" Class="stat-label">@L["Dashboard.App.Memory"]</MudText>
                <MudText Typo="Typo.body2" Class="stat-value">@(_memory ?? L["Common.Loading"])</MudText>
            </div>
            <div class="stat-row">
                <MudText Typo="Typo.body2" Class="stat-label">@L["Dashboard.App.Uptime"]</MudText>
                <MudText Typo="Typo.body2" Class="stat-value"><span @ref="_uptimeElement">@(_uptime ?? L["Common.Loading"])</span></MudText>
            </div>
        </MudPaper>

        <MudPaper Elevation="0" Class="card">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="card-header">
                <MudText Typo="Typo.h6">@L["Dashboard.Bots.Title"]</MudText>
                <MudTooltip Delay="500" Text="@L["Common.Refresh"]">
                    <MudIconButton Color="Color.Info"
                                   Icon="@Icons.Material.Filled.Refresh"
                                   Disabled="@_loadingBotStatuses"
                                   OnClick="LoadBotStatuses"
                                   aria-label="@L["Dashboard.Bots.Refresh"]" />
                </MudTooltip>
            </MudStack>

            <MudStack Spacing="1">
                @foreach (var status in _botStatuses)
                {
                    <BotEnabledControl @key="status.BotName"
                                       Status="status"
                                       Class="py-2"
                                       OnStatusChanged="LoadBotStatuses">
                        <Label>
                            <MudText Typo="Typo.body1" Class="stat-value">@status.BotName</MudText>
                        </Label>
                    </BotEnabledControl>
                }

                @if (_botStatuses.Count == 0 && !_loadingBotStatuses)
                {
                    <MudText>@L["Dashboard.Bots.Empty"]</MudText>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
</MudItem>