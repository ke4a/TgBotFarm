# Copy this file to .env and fill in real values. .env itself is gitignored and must never be committed.

# Selects which tunnel client the "tunnel" container runs (it bundles both LocalTunnel
# and ngrok - see BotFarm/Dockerfile-tunnel), and which one BotFarm registers its webhook with.
# localtunnel | ngrok
WEBHOOK_MODE=localtunnel

# Required to actually use ngrok. Get yours from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional: code required on /Account/Setup to create the first admin account (at least 16 characters).
# Leave empty to have BotFarm generate a random one-time code and print it in the startup log.
SETUP_CODE=
