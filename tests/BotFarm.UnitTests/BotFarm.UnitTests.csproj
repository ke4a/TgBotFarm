<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BotFarm.TestKit\BotFarm.TestKit.csproj" />
    <ProjectReference Include="..\..\BotFarm\BotFarm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\monitoring\grafana\dashboards\botfarm-dashboard.json" Link="monitoring\grafana\dashboards\botfarm-dashboard.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\monitoring\grafana\dashboards.yaml" Link="monitoring\grafana\dashboards.yaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\monitoring\docker-compose.yml" Link="monitoring\docker-compose.yml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
