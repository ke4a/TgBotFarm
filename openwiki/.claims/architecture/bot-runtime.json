    {
      "id": "claim_18857001ed2343148319fa593f683c45",
      "statement": "The shared BotService resolves named BotConfig options using BotIdentity.Name, requires a configured token before creating the Telegram client, sets webhooks with the bot's secret token, and pauses by deleting the webhook, returning false after logging a non-cancellation failure; it has no resume operation of its own.",
      "evidence": [
        {
          "resource": "repo://BotFarm.Core/Base/BotService.cs#L23-L98",
          "version": "repo-lines-v1:sha256:189638408671b8a5dfaea14d50a5a20ae26df413f3e5d97c92ba2a1f7a3b3048:"
        }
      ]
    },
