@page "/testbot/dashboard"
@attribute [Authorize]
@inject IStringLocalizer<TestBotDashboard> L

<PageTitle>@L["Page.Title"]</PageTitle>
<h1 class="mud-sr-only">@L["Page.Heading"]</h1>

<BotDashboard BotName="@Constants.Name" LogoSrc="img/testbot_logo.png">
    <Footer>@L["Page.Footer"]</Footer>
</BotDashboard>
